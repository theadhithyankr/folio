{
  "name": "folio-reader",
  "version": "1.0.0",
  "description": "A quiet home for every story",
  "author": "Folio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs",
    "pack": "npm run build && electron-builder --win nsis portable",
    "smoke": "electron tests/desktop-smoke.cjs",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@fontsource/manrope": "*",
    "@fontsource/source-serif-4": "*",
    "@phosphor-icons/react": "^2.1.9",
    "epubjs": "*",
    "node-unrar-js": "*",
    "pdfjs-dist": "*",
    "react": "*",
    "react-dom": "*",
    "sql.js": "*",
    "webtorrent": "*",
    "yauzl": "*"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@vitejs/plugin-react": "*",
    "concurrently": "*",
    "electron": "*",
    "electron-builder": "*",
    "typescript": "*",
    "vite": "*",
    "wait-on": "*"
  },
  "build": {
    "appId": "com.folio.reader",
    "productName": "Folio",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm",
      "node_modules/node-unrar-js/**/*.wasm"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release"
    },
    "npmRebuild": false
  }
}
